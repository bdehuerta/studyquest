# The built app. 7MB, rebuilt from source by ./build-app.sh in one command.
dist/

# YOUR SAVES. `data/` is the dev data directory — real slots, real tasks, real
# study sessions, and whatever you typed into them. It is yours, it is not code,
# and it has no business in a repository. The game recreates it on first run.
data/

# Test screenshots. 6MB, and every one of them is regenerated by
# `node tools/smoke.mjs`. They are evidence, not source.
tools/shots/

# macOS, editors, logs
.DS_Store
*.log
node_modules/
